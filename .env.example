# =============================================================================
# Laya & Bee Wish Wall — environment
#
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# All three Supabase values come from: Supabase dashboard → your project →
# Settings (gear, bottom left) → API Keys.
# =============================================================================

# Settings → API Keys → "Project URL" (or Settings → Data API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Settings → API Keys → "Publishable key". Starts with sb_publishable_
# Safe to expose in the browser; Row Level Security governs what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Settings → API Keys → "Secret keys" → reveal or create one. Starts with sb_secret_
# SECRET: bypasses Row Level Security. Server-side only — never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Older projects instead show legacy JWT keys (long strings starting "eyJ") under
# Settings → API Keys → "Legacy API keys". Those still work — use these names:
#
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...      (the "anon public" key)
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...          (the "service_role" key)
#
# Supabase is retiring the legacy keys at the end of 2026, so prefer the
# publishable/secret pair above for anything new.
# ---------------------------------------------------------------------------

# Absolute origin used when generating QR codes and share links.
# Leave unset locally. On Vercel set it to your real domain so printed QR codes
# do not point at a preview URL.
# NEXT_PUBLIC_SITE_URL=https://wishes.layanbee.com

# Salts the IP hashes used for guest rate limiting. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
IP_HASH_SALT=change-me-to-something-random

# TESTING ONLY. Turns off the per-IP limits on guest wishes (3 a minute, 8 per
# event) so you can send many from one machine. The dashboard shows a warning
# banner while it is on. Remove it — and redeploy — before a real event.
# DISABLE_WISH_RATE_LIMIT=1
